{
	"name": "svstate-kit",
	"version": "26.03.31",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"sync": "svelte-kit sync",
		"ts:check": "node --run sync && svelte-check --tsconfig ./tsconfig.json",
		"format:check": "prettier --check .",
		"format:fix": "prettier --write --list-different .",
		"lint:check": "eslint .",
		"lint:fix": "eslint --fix .",
		"all": "node --run format:fix && node --run lint:fix && node --run format:fix && node --run ts:check && node --run build",
		"npm:reinstall": "rm -rf ./node_modules && rm -f ./package-lock.json && npm i && npm i"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.1",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-svelte": "^3.22.0",
		"eslint-plugin-unicorn": "^72.0.0",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"flowbite-svelte-icons": "^3.1.0",
		"globals": "^17.8.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.2.0"
	},
	"dependencies": {
		"@trpc/client": "^11.18.0",
		"@trpc/server": "^11.18.0",
		"cookie": "^2.0.1",
		"superjson": "^2.2.6",
		"svstate": "^1.5.6",
		"zod": "^4.4.3"
	}
}
